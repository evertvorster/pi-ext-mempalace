{
  "name": "pi-ext-mempalace",
  "version": "0.3.0",
  "description": "MemPalace durable memory for pi — a cheap always-on recall tool, a deferred management tool, and the knowledge graph behind both",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "commands.ts",
    "dispatch.ts",
    "palace.ts",
    "policy.ts",
    "render.ts",
    "wing.ts",
    "scripts/*.py",
    "skills/**/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "mempalace",
    "memory",
    "knowledge-graph"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "scripts": {
