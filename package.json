{
  "name": "pi-ext-mempalace",
  "version": "0.2.0",
  "description": "MemPalace durable memory extension for pi coding agent — structured memories, knowledge graph, session hooks, and cross-wing navigation",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "scripts/bridge.py",
    "scripts/cleanup_rooms.py",
    "skills/**/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "mempalace",
    "memory",
    "knowledge-graph"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  }
}
